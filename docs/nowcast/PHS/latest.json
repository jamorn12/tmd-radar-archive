import os
import glob
import json
from datetime import datetime, timezone

def generate_clean_manifest(folder_path="docs/nowcast/PHS"):
    pattern = os.path.join(folder_path, "PHS_*_solid.png")
    files = glob.glob(pattern)
    files.sort()
    
    if not files:
        print("❌ ไม่พบไฟล์ภาพเรดาร์ในโฟลเดอร์")
        return

    obs_frames = []
    for file_path in files:
        filename = os.path.basename(file_path)
        try:
            parts = filename.split("_")
            date_str = parts[1]
            time_str = parts[2].replace("Z", "").split(".")[0]
            
            dt = datetime.strptime(f"{date_str} {time_str}", "%Y%m%d %H%M").replace(tzinfo=timezone.utc)
            timestamp = int(dt.timestamp())
            
            obs_frames.append({
                "t": timestamp,
                "url": filename
            })
        except Exception as e:
            print(f"⚠️ ข้ามไฟล์ {filename}: {e}")
            
    if not obs_frames:
        return

    obs_frames.sort(key=lambda x: x["t"])
    recent_obs = obs_frames[-6:] # เอา 6 เฟรมล่าสุดที่มีอยู่จริง
    
    frames = []
    total_obs = len(recent_obs)
    
    for i, item in enumerate(recent_obs):
        offset = (i - (total_obs - 1)) * 15
        frames.append({
            "t": item["t"],
            "url": item["url"],
            "offset_min": offset,
            "kind": "obs"
        })
        
    latest_t = recent_obs[-1]["t"]
    latest_url = recent_obs[-1]["url"]
    
    # สร้างเฟรม Nowcast ล่วงหน้า 4 เฟรม
    for step in range(1, 5):
        future_offset = step * 15
        future_t = latest_t + (future_offset * 60)
        frames.append({
            "t": future_t,
            "url": latest_url,
            "offset_min": future_offset,
            "kind": "nowcast"
        })

    manifest = {
        "projection": "+proj=laea +lat_0=16.77 +lon_0=100.22 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs",
        "grid": [160, 160],
        "kmperpixel": 3.0,
        "motion": {"speed_kmh": 15.0, "direction_deg": 270},
        "frames": frames
    }
    
    manifest_path = os.path.join(folder_path, "latest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)
        
    print(f"✅ สร้าง Manifest สะอาดปลอดภัยสำเร็จ! (รวม {len(frames)} เฟรมจากไฟล์ที่มีจริง)")

if __name__ == "__main__":
    generate_clean_manifest()
